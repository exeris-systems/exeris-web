{
  "name": "exeris-web",
  "version": "1.0.0",
  "description": "Static source of exeris.eu",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "data": "node scripts/fetch-data.mjs",
    "generate:views": "node scripts/generate-views.mjs",
    "index": "node scripts/build-index.mjs",
    "prepare:site": "npm run data && npm run generate:views && npm run index",
    "check:content": "node scripts/check-content.mjs",
    "check:views": "node scripts/check-views-deterministic.mjs",
    "check": "npm run check:content && npm run check:views",
    "claims:lock": "node scripts/check-content.mjs --lock",
    "prestart": "npm run prepare:site",
    "start": "ng serve exeris-web",
    "prebuild": "npm run prepare:site && npm run check:content",
    "build": "ng build exeris-web",
    "build:docs": "node scripts/docs/fetch-docs.mjs && ng build docs && node scripts/postbuild.mjs docs && node scripts/verify-dist.mjs docs",
    "build:lab": "ng build lab && node scripts/verify-dist.mjs lab",
    "postbuild": "node scripts/postbuild.mjs && node scripts/verify-dist.mjs",
    "lighthouse": "node scripts/lighthouse-ci.mjs",
    "serve:dist": "node scripts/serve-static.mjs",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@angular/common": "~22.2.1",
    "@angular/compiler": "~22.2.1",
    "@angular/core": "~22.2.1",
    "@angular/platform-browser": "~22.2.1",
    "@angular/platform-server": "~22.2.1",
    "@angular/router": "~22.2.1",
    "@angular/ssr": "~22.2.5",
    "@exeris/ui-kit": "^0.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~22.2.5",
    "@angular/cli": "~22.2.5",
    "@angular/compiler-cli": "~22.2.1",
    "@eslint/js": "^10.0.1",
    "@exeris/codegen-ts": "0.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.0.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "markdown-it": "^14.3.3",
    "postcss": "^8.5.0",
    "sanitize-html": "^2.18.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.5"
  }
}
